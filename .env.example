# --- Application ---
NEXT_PUBLIC_APP_NAME=Movacash
# Adresse publique du site (ex. https://movacash.fr) : sert aux liens Stripe et aux e-mails
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret de signature des sessions (32+ caractères aléatoires). Conseillé ; sans lui, une clé est dérivée de DATABASE_URL.
AUTH_SECRET=change-me-with-a-long-random-string
# Adresse de contact affichée dans la page Aide
SUPPORT_EMAIL=

# --- Base de données ---
# Production (Vercel) : base Postgres Neon, ajoutée depuis Vercel → Storage, qui remplit DATABASE_URL tout seul.
# Sans DATABASE_URL : base PGlite embarquée (dossier local en développement, en mémoire et effacée régulièrement sur Vercel).
DATABASE_URL=
# Local uniquement : dossier de la base PGlite
DATABASE_PATH=./data/pglite

# --- Gemini (génération des e-books) ---
# Sans clé : mode démo (contenu exemple, pas d'appel à l'API).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (abonnements) ---
# Sans clé : mode démo (l'abonnement s'active sans paiement, pour tester).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Facultatif : prix annuels. Si les trois ne sont pas renseignés, le choix « Annuel » est masqué.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=

# --- E-mails (mot de passe oublié) via Resend (https://resend.com) ---
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend, ex. : Movacash <bonjour@movacash.fr>
EMAIL_FROM=

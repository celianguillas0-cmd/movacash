# --- Application ---
NEXT_PUBLIC_APP_NAME=Movacash
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret de signature des sessions (32+ caractères aléatoires). OBLIGATOIRE en production.
AUTH_SECRET=change-me-with-a-long-random-string
# Chemin du fichier SQLite (doit être sur un disque persistant en production)
DATABASE_PATH=./data/movacash.db

# --- Gemini (génération des e-books) ---
# Sans clé : mode démo (contenu exemple, pas d'appel à l'API).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (abonnements) ---
# Sans clé : mode démo (l'abonnement s'active sans paiement, pour tester).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Facultatif : prix annuels (sinon le choix « Annuel » renvoie une erreur)
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=
